@model Library.Models.Loan.LoanReturnViewModel

@{
    ViewData["Title"] = "Return Book";
}

<div class="container py-5">
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2">
            LIBRARY MANAGEMENT
        </span>

        <h1 class="display-5 fw-bold mb-2">Return Book</h1>

        <p class="text-muted">
            Confirm the return of this borrowed book.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Loan Information</h5>
            <p class="text-muted small mb-0">
                Review the details before returning the book.
            </p>
        </div>

        <div class="card-body p-4 p-md-5">

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <p class="text-muted small mb-1">Book Title</p>
                        <h6 class="fw-semibold mb-0">@Model.Title</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <p class="text-muted small mb-1">Reader Full Name</p>
                        <h6 class="fw-semibold mb-0">@Model.FullName</h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <p class="text-muted small mb-1">Loan Date</p>
                        <h6 class="fw-semibold mb-0">
                            @Model.LoanDate.ToString("dd.MM.yyyy HH:mm")
                        </h6>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <p class="text-muted small mb-1">Return Date</p>
                        <h6 class="fw-semibold mb-0">
                            @(Model.ReturnDate?.ToString("dd.MM.yyyy HH:mm") ?? "Not returned")
                        </h6>
                    </div>
                </div>
            </div>

            <div class="alert alert-info rounded-3">
                <strong>Ready to return?</strong>
                Confirm below to mark this book as available in the library.
            </div>

            <form asp-controller="Loan"
                  asp-action="Return"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2">
                    <button type="submit"
                            class="btn btn-success btn-lg rounded-3 px-4">
                        Confirm Return
                    </button>

                    <a asp-controller="Loan"
                           asp-action="Index"
                           class="btn btn-outline-secondary btn-lg rounded-3 px-4">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}