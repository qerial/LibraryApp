@model Library.Models.Book.DeleteViewModel

<h1>Delete</h1>

<div>
    <h4>Books</h4>
    <hr />

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Id)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Title" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Title)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Author" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.Author)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="PublishedYear" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.PublishedYear)
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="IsAvailable" class="col-sm-2 col-form-label"></label>
            @Html.DisplayFor(Model => Model.IsAvailable)
        </div>
    </dl>
    <hr />
    <div>
        <h3>Are you sure you want to delete this book?</h3>

        <dl class="row">
            <dt class="col-sm-2">Title</dt>
            <dd class="col-sm-10">@Model.Title</dd>

            <dt class="col-sm-2">Author</dt>
            <dd class="col-sm-10">@Model.Author</dd>

            <dt class="col-sm-2">Published Year</dt>
            <dd class="col-sm-10">@Model.PublishedYear</dd>
        </dl>

        <form asp-action="DeleteConfirmation" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-outline-danger">
                Delete
            </button>

            <a asp-action="Index"
               asp-controller="Book"
               class="btn btn-outline-info">
                Back
            </a>
        </form>
    </div>
</div>